/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/data/*
  Cache-Control: public, max-age=0, must-revalidate

/downloads/*
  Cache-Control: public, max-age=0, must-revalidate

/templates/*
  Cache-Control: public, max-age=0, must-revalidate

/downloads/UStudy-android.apk
  Content-Disposition: attachment; filename="UStudy-android.apk"
  Content-Type: application/vnd.android.package-archive

https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
